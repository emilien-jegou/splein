# Canonical hot-reload companion packages for the desktop-glass overlay host.
# Single source of truth: the example.sh overlay mode (hand build) and
# DevLoopConfig::companion_packages via riode::hot_reload::companion_set
# (loop rebuilds) both read this file. The sets MUST be identical on both
# sides: cargo unifies features across the requested packages, and any
# difference compiles rival `riode` units whose dylib symbols never resolve
# (undefined RawVec HookScope symbols at every dlopen attempt, forever).
riode-shared riode-hot-gen-ui desktop-glass
